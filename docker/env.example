APP_NAME=rag-server
ENVIRONMENT=local
LOG_LEVEL=INFO
API_PREFIX=

QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=documents
QDRANT_TIMEOUT_SECONDS=20
EMBEDDING_DIMENSION=1536
VECTOR_DISTANCE=cosine
HYBRID_PREFETCH_LIMIT=20

OPENAI_API_KEY=<dein-key>
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TIMEOUT_SECONDS=60

OPENAI_CHAT_MODEL=gpt-5-mini
# openai or ollama


# Ollama embeddings (set LLM_EMBEDDING_BACKEND=ollama)
LLM_EMBEDDING_BACKEND=ollama
LLM_EMBEDDING_ENDPOINT=http://localhost
LLM_EMBEDDING_MODEL=embeddinggemma
LLM_EMBEDDING_MODEL=qwen3.5:4b
OLLAMA_TIMEOUT_SECONDS=60

RETRIEVAL_TOP_K=6
RETRIEVAL_MIN_SCORE=0.015
MIN_RAG_HITS=1
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_CONTEXT_CHUNKS=8

PROVIDER_MAX_RETRIES=3
PROVIDER_RETRY_BASE_DELAY_SECONDS=0.5

SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_HOURS=24

# Hinweis: Beim ersten Start nach dem Update wird die Qdrant-Collection
# bei inkompatiblem Schema gelöscht und neu angelegt. Daten müssen
# erneut über parseUrl/parseHtml/parsePdf mit store_in_db=true indexiert werden.

CORS_ORIGINS=["*"]
CORS_ALLOW_CREDENTIALS=false
