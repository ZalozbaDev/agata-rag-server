APP_NAME=rag-server
ENVIRONMENT=local
LOG_LEVEL=INFO
API_PREFIX=

QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=documents
# Optional allowlist for per-persona collections. Empty = any valid name allowed.
QDRANT_ALLOWED_COLLECTIONS=
QDRANT_TIMEOUT_SECONDS=20
# Fallback only when a document has no de/hsb signal. Detection from the
# text wins; an explicit `language` on the parse endpoints overrides both.
DOCUMENT_LANGUAGE=de
EMBEDDING_DIMENSION=768
VECTOR_DISTANCE=cosine
HYBRID_PREFETCH_LIMIT=20

OPENAI_API_KEY=<dein-key>
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TIMEOUT_SECONDS=60

OPENAI_CHAT_MODEL=gpt-5-mini
# openai or ollama


# Ollama embeddings (set LLM_EMBEDDING_BACKEND=ollama)
LLM_EMBEDDING_BACKEND=ollama
LLM_EMBEDDING_ENDPOINT=http://localhost
LLM_EMBEDDING_API_KEY=<dein-key>
LLM_EMBEDDING_MODEL=embeddinggemma
LLM_EMBEDDING_MODEL=qwen3.5:4b
OLLAMA_TIMEOUT_SECONDS=60

RETRIEVAL_TOP_K=6
# Cosine floor for dense candidates. Replaces RETRIEVAL_MIN_SCORE, which was
# applied to RRF fusion scores and therefore cut by rank, never by relevance.
RETRIEVAL_SCORE_THRESHOLD=0.4
RETRIEVAL_CANDIDATE_MULTIPLIER=4
MIN_RAG_HITS=1
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_CONTEXT_CHUNKS=8

# Default BM25 Snowball language for German (and other supported languages).
# Upper Sorbian is handled separately: unstemmed, no stopwords.
BM25_LANGUAGE=german

# 'gemma' | 'none' | empty to auto-detect from the model name
EMBEDDING_PROMPT_STYLE=
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_PARALLEL_BATCHES=4
QUERY_EMBEDDING_CACHE_SIZE=512
UPSERT_BATCH_SIZE=128

DEDUP_SIMILARITY_THRESHOLD=0.85
MERGE_ADJACENT_CHUNKS=true

# Optional cross-encoder rerank. Downloads ~1.1 GB on first use.
RERANK_ENABLED=false
RERANK_MODEL=jinaai/jina-reranker-v2-base-multilingual
RERANK_SCORE_THRESHOLD=0.0

PROVIDER_MAX_RETRIES=3
PROVIDER_RETRY_BASE_DELAY_SECONDS=0.5

SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_HOURS=24

# Hinweis: Beim ersten Start nach dem Update wird die Qdrant-Collection
# bei inkompatiblem Schema gelöscht und neu angelegt. Daten müssen
# erneut über parseUrl/parseHtml/parsePdf mit store_in_db=true indexiert werden.

CORS_ORIGINS=["*"]
CORS_ALLOW_CREDENTIALS=false
